<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth Classic permissions. -->
    <!-- Legacy (API < 31): needed to query bonded devices / connect SPP. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Runtime permissions (API 31+). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Declared for completeness; the bridge never performs discovery. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Foreground service hosting the HTTP server + BT socket. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Localhost HTTP server. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notification permission (API 33+) for the foreground notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declare that this app uses Bluetooth Classic (not required to be BLE-only). -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PrintService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
